Source: "Frontend\checkDef.cmd"; DestDir: "{app}"; Flags: ignoreversion
Source: "Frontend\checkdotNet481Installed.js"; DestDir: "{app}"; Flags: ignoreversion
Source: "Frontend\checkRedist2015bundle.js"; DestDir: "{app}"; Flags: ignoreversion
Source: "Frontend\checkWinOS.cmd"; DestDir: "{app}"; Flags: ignoreversion
Source: "Frontend\CURL.EXE"; DestDir: "{app}"; Flags: ignoreversion
Source: "Frontend\ele.exe"; DestDir: "{app}"; Flags: ignoreversion
Source: "Frontend\Get-AntivirusDetails.ps1"; DestDir: "{app}"; Flags: ignoreversion
Source: "Frontend\getOSArch.ps1"; DestDir: "{app}"; Flags: ignoreversion
Source: "Frontend\Launch.exe"; DestDir: "{app}"; Flags: ignoreversion
