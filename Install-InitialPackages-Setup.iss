[Icons]
Name: "{group}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"
Name: "{group}\{cm:UninstallProgram,{#MyAppName}}"; Filename: "{uninstallexe}"
Name: "{commondesktop}\{#MyAppName}"; Filename: "{app}\main.hta"; WorkingDir: "{app}"; IconFilename: "{app}\niticon.ico"; IconIndex: 0; Tasks: desktopicon
Name: "{group}\Main Script"; Filename: "{app}\main.hta"; WorkingDir: "{app}"; IconFilename: "{app}\niticon.ico"; IconIndex: 0
Name: "{group}\PostInstall Script"; Filename: "{app}\postinstalscript.bat"; WorkingDir: "{app}"

[Run]
Filename: "{app}\postinstalscript.bat"; WorkingDir: "{app}"; Flags: shellexec postinstall skipifsilent; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"
