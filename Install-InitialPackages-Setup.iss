; Script generated by the Inno Script Studio Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!

#define MyAppName "Initial Packages Frontend"
#define MyAppVersion "1.0.0.0"
#define MyAppPublisher "New Internet Technologies, Inc."
#define MyAppURL "http://nit.netip6.ru/"
#define MyAppExeName "getWinOperationSystem.Example.js"

[Setup]
; NOTE: The value of AppId uniquely identifies this application.
; Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={{75CEED46-64F9-471F-972D-C149725980CC}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
;AppVerName={#MyAppName} {#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultDirName=C:\pub1\Distrib\Zlovred\Frontend
DefaultGroupName={#MyAppName}
LicenseFile=.\license.rtf
OutputDir=.\Output
OutputBaseFilename=InstallInitialPackagesSetup
SetupIconFile=.\NIT-Gear-0004-001-256sq.ico
Compression=lzma
SolidCompression=yes
AppCopyright=(c) 2026 New Internet Technologies, Inc.
RestartIfNeededByRun=False
AllowCancelDuringInstall=False
EnableDirDoesntExistWarning=True
AppComments=Setup Initialisation Packages after Windows Installation
UninstallDisplayName=Install Initial Packages
UninstallDisplayIcon={app}\niticon.ico
VersionInfoVersion={#MyAppVersion}
VersionInfoCompany={#MyAppPublisher}
VersionInfoDescription=Setup Initialisation Packages after Windows Installation
VersionInfoCopyright=(C) 2026 New Internet Technologies, Inc.
VersionInfoProductName={#MyAppName}
VersionInfoProductVersion={#MyAppVersion}
MinVersion=0,6.1sp1
AlwaysUsePersonalGroup=True
AppendDefaultGroupName=False
UserInfoPage=True

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"
Name: "russian"; MessagesFile: "compiler:Languages\Russian.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
Source: "Frontend\getWinOperationSystem.Example.js"; DestDir: "{app}"; Flags: ignoreversion
; NOTE: Don't use "Flags: ignoreversion" on any shared system files
Source: "Frontend\7za.dll"; DestDir: "{app}"; Flags: ignoreversion
Source: "Frontend\7za.exe"; DestDir: "{app}"
